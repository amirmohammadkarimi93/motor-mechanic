// Prisma schema - Motorcycle Repair Website CMS
// All entities have SEO fields for technical SEO optimization

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Admin user for the CMS panel with RBAC roles
// Roles: super_admin | editor | author | landing_editor
// - super_admin: full access (all modules + user management)
// - editor: articles + categories(landings) + services + media + messages(read)
// - author: articles (own) + media (own)
// - landing_editor: categories(landings) + media + messages(read)
model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String?
  email     String?
  role      String   @default("author") // super_admin | editor | author | landing_editor
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations to content this user created
  articles  Article[]
  categories Category[]
  media     Media[]

  @@index([role])
  @@index([active])
}

// Category = dynamic SEO page (e.g. "تعمیر موتورگلکسی در مشهد")
// Admin can create unlimited categories dynamically with full SEO control
model Category {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  brand           String?  // motorcycle brand: galaxy, benelli, cross, aprilia...
  city            String?  // city: mashhad, tehran...
  shortDescription String? // for listing cards
  content         String? // long SEO markdown body for the page
  image           String? // cover image URL
  icon            String?  // lucide icon name
  // SEO fields
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  canonicalUrl    String?
  ogImage         String?
  structuredData  String? // JSON-LD override
  // Hierarchy (optional sub-categories)
  parentId        String?
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryHierarchy")
  // Relations
  articles        Article[]
  // Audit
  authorId        String?
  author          AdminUser? @relation(fields: [authorId], references: [id])
  // Display
  featured        Boolean  @default(false)
  published       Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([parentId])
  @@index([published])
  @@index([featured])
  @@index([authorId])
}

// Article / blog post
model Article {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  excerpt         String?
  content         String   // markdown content
  coverImage      String?
  // SEO fields
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  canonicalUrl    String?
  ogImage         String?
  structuredData  String?
  // Relations
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  // Audit
  authorId        String?
  author          AdminUser? @relation(fields: [authorId], references: [id])
  // Meta
  authorName      String?
  readingTime     Int?     // minutes
  tags            String?  // comma-separated
  featured        Boolean  @default(false)
  published       Boolean  @default(true)
  publishedAt     DateTime?
  views           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categoryId])
  @@index([published])
  @@index([featured])
  @@index([publishedAt])
  @@index([authorId])
}

// Service offered by the repair shop
model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  icon        String?
  image       String?
  price       String?  // "توافقی", "از 500 هزار تومان", etc.
  features    String?  // JSON array string
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Media library - uploaded images with alt/title for accessibility + SEO
model Media {
  id          String   @id @default(cuid())
  filename    String   // original filename
  url         String   // stored path: /uploads/...
  alt         String?  // alt text for accessibility (SEO)
  title       String?  // title attribute
  caption     String?  // optional caption
  mimeType    String?
  size        Int?     // bytes
  width       Int?
  height      Int?
  // Audit
  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([uploadedById])
  @@index([createdAt])
}

// Singleton site settings (one row only)
model SiteSettings {
  id              String   @id @default("singleton")
  // Brand
  siteName        String?
  siteDescription String?
  logoText        String?
  // Contact
  phone           String?
  whatsapp        String?
  email           String?
  address         String?
  workingHours    String?
  mapEmbed        String?
  instagram       String?
  telegram        String?
  // About
  aboutTitle      String?
  aboutContent    String? // markdown
  aboutImage      String?
  // Hero
  heroBadge       String?
  heroTitle       String?
  heroSubtitle    String?
  heroImage       String?
  heroCtaText     String?
  // Homepage extras
  features        String? // JSON array
  stats           String? // JSON array of {label,value,suffix}
  testimonials    String? // JSON array of {name, role, content, rating, avatar}
  faqs            String? // JSON array of {question, answer}
  processSteps    String? // JSON array of {step, title, description, icon}
  // Footer
  footerText      String?
  // Global SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImage         String?
  // Theme
  primaryColor    String? // override brand color
  updatedAt       DateTime @updatedAt
}

// Contact form submissions
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

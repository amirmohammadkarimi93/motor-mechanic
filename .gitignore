# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.production
.env.development

# Keep .env.example (template)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*

# Agent context (internal logs)
.agent-ctx
.claude
.z-ai-config

# Logs
*.log
dev.log
dev.out.log
server.log
prompt
test

# Skills directory
/skills/

# Database (SQLite - each user should create their own)
/db/*.db
/db/*.db-journal

# Uploaded files (user-generated content at runtime)
/public/uploads/*
!/public/uploads/.gitkeep

# Generated scripts output
/tmp/
